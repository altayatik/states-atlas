rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAtlasAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "altayatik01@gmail.com"
          || request.auth.token.email == "aidima821@gmail.com"
        )
        && request.auth.token.email_verified == true;
    }

    match /stateTravelEntries/{stateCode} {
      allow read: if true;
      allow create, update, delete: if isAtlasAdmin();
    }

    match /parkRankings/{rankingId} {
      allow read: if true;
      allow create, update, delete: if isAtlasAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
