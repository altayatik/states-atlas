rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /stateTravelEntries/{stateCode} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /parkRankings/{rankingId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
